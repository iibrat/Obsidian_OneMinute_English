{
  "name": "obsidian-one-minute-english",
  "version": "1.0.5",
  "description": "A focused One Minute English dashboard for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test scripts/test-ai.mjs scripts/test-highlight-ai.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "keywords": [
    "obsidian",
    "english",
    "dashboard"
  ],
  "author": "One Minute English",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  }
}
